{
  "name": "rantjs",
  "version": "2.1.0",
  "description": "Write a pattern, get a sentence. Seeded procedural text for JavaScript.",
  "license": "ISC",
  "author": {
    "name": "Sven Anders Robbestad",
    "email": "anders@robbestad.com",
    "url": "https://www.robbestad.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robbestad/Rantjs.git"
  },
  "homepage": "https://rantjs.vercel.app",
  "bugs": {
    "url": "https://github.com/robbestad/Rantjs/issues"
  },
  "keywords": [
    "rant",
    "procedural-generation",
    "procedural-text",
    "text-generation",
    "seeded",
    "dictionary",
    "javascript",
    "typescript",
    "cli",
    "npc",
    "flavor-text",
    "sentences"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "rantjs": "dist/cli.js"
  },
  "unpkg": "./dist/rant.min.js",
  "jsdelivr": "./dist/rant.min.js",
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/index.d.cts",
    "dist/cli.js",
    "dist/rant.js",
    "dist/rant.min.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:dict && rm -rf dist && tsup",
    "build:dict": "tsx scripts/compile-dictionaries.ts",
    "test": "npm run build:dict && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo/tsconfig.json",
    "demo": "npm run build:dict && vite --config demo/vite.config.ts",
    "demo:build": "npm run build:dict && vite build --config demo/vite.config.ts",
    "prepublishOnly": "npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "svenjs": "^3.2.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "~5.6.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
